(vl-load-com)

;;=========================================================
;; LENH: BLOCK_ORIENT - XOAY BLOCK QUA 24 HUONG CO DINH
;;=========================================================
(defun c:BLOCK_ORIENT ( / *error* old_err old_vars
                        ent elist ins_pt
                        axes angles i j axis ang
                        input_res count)
  
  ;; 1. Ham xu ly loi
  (setq old_err *error*)
  (defun *error* (msg)
    (if old_vars (foreach var_pair old_vars (setvar (car var_pair) (cdr var_pair))))
    (if (and msg (not (member msg '("Function cancelled" "quit / exit abort"))))
      (prompt (strcat "\n[Error] " msg)))
    (setq *error* old_err)
    (princ)
  )
  
  ;; 2. Luu bien he thong
  (setq old_vars (list (cons 'OSMODE (getvar "OSMODE"))
                       (cons 'CMDECHO (getvar "CMDECHO"))))
  (setvar "OSMODE" 0)
  (setvar "CMDECHO" 0)
  
  ;; 3. Chon 1 block
  (prompt "\n--- CHON 1 BLOCK DE XOAY ---")
  (setq ent (car (entsel "\nChon block: ")))
  
  (if (or (null ent)
          (/= (cdr (assoc 0 (entget ent))) "INSERT"))
    (progn
      (prompt "\n[!] Khong chon duoc block.")
      (setvar "OSMODE" (cdr (assoc 'OSMODE old_vars)))
      (setvar "CMDECHO" (cdr (assoc 'CMDECHO old_vars)))
      (setq *error* old_err)
      (princ)
      (exit)
    )
  )
  
  ;; 4. Lay diem chen block
  (setq elist (entget ent))
  (setq ins_pt (cdr (assoc 10 elist)))
  
  (prompt (strcat "\n[Block] " (cdr (assoc 2 elist))
                  " | Diem chen: " (rtos (car ins_pt) 2 2) ", "
                  (rtos (cadr ins_pt) 2 2) ", "
                  (rtos (caddr ins_pt) 2 2)))
  
  ;; 5. Tao danh sach 24 huong (6 truc x 4 goc)
  ;; Truc: +X, -X, +Y, -Y, +Z, -Z
  (setq axes '(
               ("+X" 1.0 0.0 0.0)
               ("-X" -1.0 0.0 0.0)
               ("+Y" 0.0 1.0 0.0)
               ("-Y" 0.0 -1.0 0.0)
               ("+Z" 0.0 0.0 1.0)
               ("-Z" 0.0 0.0 -1.0)
              ))
  
  ;; Goc: 0, 90, 180, 270 (radian)
  (setq angles '(0.0 1.5708 3.1416 4.7124))
  
  ;; 6. Vong lap duyet qua 24 huong
  (setq i 0 count 0)
  (prompt "\n=== BAT DAU XOAY BLOCK ===")
  (prompt "\n[N] de chuyen huong tiep theo | [Enter] de xac nhan\n")
  
  (while (< i 24)
    ;; Tinh truc va goc hien tai
    (setq j (rem i 4))  ; 0,1,2,3
    (setq axis (nth (/ i 4) axes))  ; chon truc
    (setq ang (nth j angles))  ; chon goc
    
    ;; Thuc hien xoay
    (command "_.ROTATE3D" ent "" 
             "_3" 
             (list (car ins_pt) (cadr ins_pt) (caddr ins_pt))
             (list (+ (car ins_pt) (nth 1 axis))
                   (+ (cadr ins_pt) (nth 2 axis))
                   (+ (caddr ins_pt) (nth 3 axis)))
             (angtos ang 0 4))
    (while (> (getvar "CMDACTIVE") 0) (command ""))
    
    (setq count (1+ count))
    (prompt (strcat "\n[" (itoa count) "/24] Truc: " (car axis) 
                    " | Goc: " (rtos (/ ang 0.0174533) 2 0) "°"
                    " | [N] next | [Enter] xac nhan"))
    
    ;; Cho input
    (setq input_res (grread t 2 0))
    
    ;; Kiem tra input
    (cond
      ;; Phim N hoac n (ASCII 78 hoac 110)
      ((and (= (car input_res) 2)
            (or (= (cadr input_res) 78) (= (cadr input_res) 110)))
       ;; Undo buoc xoay vua roi
       (command "_.UNDO" 1)
       (setq i (1+ i))  ; Chuyen sang huong tiep theo
      )
      
      ;; Enter (ASCII 13)
      ((and (= (car input_res) 2) (= (cadr input_res) 13))
       (setq i 24)  ; Thoat vong lap
      )
      
      ;; Esc (type 25)
      ((= (car input_res) 25)
       (command "_.UNDO" 1)  ; Undo buoc xoay cuoi
       (setq i 24)  ; Thoat
       (prompt "\n[!] Huy boi nguoi dung.")
      )
      
      ;; Khac -> bo qua
      (t
       (prompt "\n[!] Nhap N hoac Enter.")
      )
    )
  )
  
  ;; 7. Ket thuc
  (setvar "OSMODE" (cdr (assoc 'OSMODE old_vars)))
  (setvar "CMDECHO" (cdr (assoc 'CMDECHO old_vars)))
  (setq *error* old_err)
  (prompt (strcat "\n[Block_Orient] Hoan thanh. Da qua " (itoa count) " huong."))
  (princ)
)

;; Alias
(defun c:BO () (c:BLOCK_ORIENT) (princ))

(princ "\n[Tool] BLOCK_ORIENT loaded. Type BO or BLOCK_ORIENT to start.")
(princ)
