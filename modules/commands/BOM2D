(vl-load-com)

;;=========================================================
;; 1. HÀM LẤY TEXT TỪ MLEADER
;;=========================================================
(defun GetMLeaderText (ml_ent / obj txt ed)
  (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list ml_ent)))
  (if (not (vl-catch-all-error-p obj))
    (setq txt (vl-catch-all-apply 'vla-get-TextString (list obj)))
  )
  (if (or (not txt) (= txt "") (= txt "nil"))
    (progn
      (setq ed (entget ml_ent))
      (foreach pair ed
        (if (= (car pair) 304)
          (if (= (type (cdr pair)) 'STR)
            (setq txt (cdr pair))
          )
        )
      )
    )
  )
  (if txt txt "")
)

;;=========================================================
;; 2. HÀM LẤY ĐIỂM MŨI TÊN
;;=========================================================
(defun GetArrowPoint (ent)
  (cdr (assoc 10 (entget ent)))
)

;;=========================================================
;; 3. HÀM PHÂN LOẠI BALLOON (Giữ nguyên tên E1, E5...)
;;=========================================================
(defun ClassifyBalloon (txt / first_char)
  (if (= txt "") (setq txt "UNKNOWN"))
  (setq first_char (substr txt 1 1))
  (cond
    ((= txt "OF") "OF")
    ((and (> (strlen txt) 2) (= (substr txt 1 2) "OF")) "OF")
    ((= first_char "P") "P")
    ((= first_char "E") txt)
    ((= first_char "R") txt)
    ((= first_char "F") txt)
    ((= first_char "G") txt)
    ((= first_char "B") txt)
    (t "OTHER")
  )
)

;;=========================================================
;; 4. HÀM TÍNH KHOẢNG CÁCH & VỊ TRÍ HÌNH CHIẾU (SCORING SYSTEM)
;; Trả về list: (khoảng_cách tham_số_t_gốc)
;; t_gốc < 0: hình chiếu nằm trước đầu p1
;; t_gốc > 1: hình chiếu nằm sau cuối p2
;; 0 <= t_gốc <= 1: hình chiếu nằm trong đoạn thẳng
;;=========================================================
(defun Pt2SegDistEx (pt p1 p2 / v1 v2 t_val cp dist len_sq)
  (setq v1 (mapcar '- p2 p1)
        v2 (mapcar '- pt p1))
  
  ;; Kiểm tra line bị trùng điểm (độ dài = 0)
  (setq len_sq (apply '+ (mapcar '* v1 v1)))
  (if (< len_sq 0.0001)
    (list (distance pt p1) 0.5)
    (progn
      (setq t_val (/ (apply '+ (mapcar '* v2 v1)) len_sq))
      (setq cp (mapcar '+ p1 (mapcar '(lambda (x) (* x t_val)) v1)))
      (setq dist (distance pt cp))
      (list dist t_val)
    )
  )
)

;;=========================================================
;; 5. HÀM FORMAT SỐ (Giữ nguyên số thập phân nếu có)
;;=========================================================
(defun FormatNumber (num)
  (if (= (rem num 1) 0)
    (rtos num 2 0)   ; Số nguyên: "200"
    (rtos num 2 2)   ; Số lẻ: "200.50"
  )
)

;;=========================================================
;; LỆNH CHÍNH: BOM2D (PHIÊN BẢN CHỐNG NHIỄU ĐƯỜNG SONG SONG)
;;=========================================================
(defun c:BOM2D ( / *error* old_vars
                 tol_dim tol_balloon
                 ss_all lst_ml lst_ln lst_dim
                 ent ent_data ent_type
                 ml_txt ml_type arrow_pt
                 ln_p1 ln_p2
                 dim_p1 dim_p2 override_str
                 dim_line_map
                 res_dict new_dict found item map_item
                 csv f stt best_line best_score score
                 dist_info dist t_orig matched_override pipe_len)

  ;; Xử lý lỗi
  (defun *error* (msg)
    (if old_vars (foreach v old_vars (setvar (car v) (cdr v))))
    (if (and msg (not (wcmatch (strcase msg) "*CANCEL*,*EXIT*")))
      (prompt (strcat "\n[Lỗi] " msg)))
    (princ)
  )

  ;; Lưu biến hệ thống
  (setq old_vars (list (cons 'OSMODE (getvar "OSMODE"))
                       (cons 'CMDECHO (getvar "CMDECHO"))))
  (setvar "OSMODE" 0) (setvar "CMDECHO" 0)
  
  (setq tol_dim 0.5)      ; Bước 1: Dim khớp Line rất chặt chẽ
  (setq tol_balloon 5.0)  ; Bước 2: Điểm số tối đa cho phép (sau khi cộng phạt)

  ;; QUÉT CHỌN
  (prompt "\n=== QUÉT CHỌN TẤT CẢ ===\n")
  (setq ss_all (ssget '((0 . "MULTILEADER,LINE,DIMENSION"))))
  
  (if (not ss_all)
    (progn (prompt "[!] Không chọn được.") (princ) (exit))
  )

  ;; PHÂN LOẠI ĐỐI TƯỢNG
  (setq lst_ml '() lst_ln '() lst_dim '())
  (foreach ent (vl-remove-if 'listp (mapcar 'cadr (ssnamex ss_all)))
    (setq ent_data (entget ent))
    (setq ent_type (cdr (assoc 0 ent_data)))
    (cond
      ((= ent_type "MULTILEADER") (setq lst_ml (append lst_ml (list ent))))
      ((= ent_type "LINE") (setq lst_ln (append lst_ln (list ent))))
      ((= ent_type "DIMENSION") (setq lst_dim (append lst_dim (list ent))))
    )
  )

  (prompt (strcat "\n[OK] " (itoa (length lst_ml)) " Balloons, "
                  (itoa (length lst_ln)) " Lines, "
                  (itoa (length lst_dim)) " Dims.\n"))

  ;;=========================================================
  ;; BƯỚC 1: DIM → LINE (CHÍNH XÁC TUYỆT ĐỐI)
  ;; Mỗi Line sẽ được gán đúng 1 Text Override của Dim khớp nó
  ;;=========================================================
  (prompt "\n=== BƯỚC 1: DIM KHỚP LINE ===\n")
  (setq dim_line_map '()) 

  (foreach dim_ent lst_dim
    (setq dim_ed (entget dim_ent))
    (setq dim_p1 (cdr (assoc 13 dim_ed)))
    (setq dim_p2 (cdr (assoc 14 dim_ed)))
    (setq override_str (cdr (assoc 1 dim_ed)))
    (if (not override_str) (setq override_str ""))
    
    (setq matched_line nil)
    (foreach ln_ent lst_ln
      (setq ln_ed (entget ln_ent))
      (setq ln_p1 (cdr (assoc 10 ln_ed)))
      (setq ln_p2 (cdr (assoc 11 ln_ed)))
      
      (if (or 
            (and (< (distance dim_p1 ln_p1) tol_dim) (< (distance dim_p2 ln_p2) tol_dim))
            (and (< (distance dim_p1 ln_p2) tol_dim) (< (distance dim_p2 ln_p1) tol_dim))
          )
        (setq matched_line ln_ent)
      )
    )
    
    (if matched_line
      (progn
        (setq dim_line_map (append dim_line_map (list (cons matched_line override_str))))
        (prompt (strcat "  Dim \"" override_str "\" → Khớp Line\n"))
      )
      (prompt (strcat "  Dim \"" override_str "\" [!] Không tìm thấy line\n"))
    )
  )

  ;;=========================================================
  ;; BƯỚC 2: BALLOON → LINE (HỆ THỐNG TÍNH ĐIỂM SCORING)
  ;; Chống nhiễu đường ống song song
  ;;=========================================================
  (prompt "\n=== BƯỚC 2: BALLOON KHỚP LINE (SCORING) ===\n")
  (setq res_dict '())

  (foreach ml_ent lst_ml
    (setq ml_txt (GetMLeaderText ml_ent))
    (setq ml_type (ClassifyBalloon ml_txt))
    (setq arrow_pt (GetArrowPoint ml_ent))

    (if (and arrow_pt (= ml_type "P"))
      (progn
        ;; Tìm line có điểm số thấp nhất (khớp nhất)
        (setq best_line nil best_score 99999.0)
        
        (foreach map_item dim_line_map
          (setq ln_ent (car map_item))
          (setq ln_ed (entget ln_ent))
          (setq ln_p1 (cdr (assoc 10 ln_ed)))
          (setq ln_p2 (cdr (assoc 11 ln_ed)))
          
          ;; Lấy khoảng cách thực tế và tham số t (vị trí hình chiếu)
          (setq dist_info (Pt2SegDistEx arrow_pt ln_p1 ln_p2))
          (setq dist (car dist_info))
          (setq t_orig (cadr dist_info))
          
          ;; --- LOGIC TÍNH ĐIỂM ---
          (setq score dist)
          
          ;; Nếu hình chiếu nằm NGOÀI đoạn thẳng (gần đầu/cuối mút)
          (if (or (< t_orig 0.0) (> t_orig 1.0))
            (progn
              ;; Nếu cách đầu mút > 1.0 đơn vị: Cộng thêm 10 điểm phạt
              ;; Để ưu tiên các đường mà mũi tên chiếu thẳng vào giữa
              (if (> dist 1.0)
                (setq score (+ dist 10.0))
              )
              ;; Nếu cách đầu mút < 1.0: Giữ nguyên (không phạt)
              ;; Vì chắc chắn balloon đang chỉ vào đầu ống này
            )
          )
          
          ;; Cập nhật line có điểm số thấp nhất
          (if (< score best_score)
            (setq best_line ln_ent best_score score)
          )
        )
        
        ;; Lấy chiều dài từ Dim đã khớp ở Bước 1
        (setq pipe_len 0.0 matched_override nil)
        (if (and best_line (< best_score tol_balloon))
          (progn
            (setq map_item (assoc best_line dim_line_map))
            (if map_item
              (progn
                (setq matched_override (cdr map_item))
                (if (and matched_override (> (strlen matched_override) 0))
                  (setq pipe_len (atof matched_override))
                )
              )
            )
          )
        )
        
        (prompt (strcat "  " ml_txt " → Score: " (rtos best_score 2 2) 
                        " | Dim: \"" (if matched_override matched_override "N/A") 
                        "\" | Length: " (rtos pipe_len 2 2) "\n"))
        
        ;; Cộng dồn chiều dài cho cùng mã P
        (setq found nil new_dict '())
        (foreach item res_dict
          (if (= (car item) ml_txt)
            (progn (setq new_dict (append new_dict (list (cons ml_txt (+ (cdr item) pipe_len)))) found t))
            (setq new_dict (append new_dict (list item)))
          )
        )
        (if (not found) (setq new_dict (append new_dict (list (cons ml_txt pipe_len)))))
        (setq res_dict new_dict)
      )

      ;; FITTING (Đếm riêng E1, E5, R1, F2...)
      (if (and ml_type (/= ml_type "OTHER"))
        (progn
          (setq found nil new_dict '())
          (foreach item res_dict
            (if (= (car item) ml_type)
              (progn (setq new_dict (append new_dict (list (cons ml_type (1+ (cdr item))))) found t))
              (setq new_dict (append new_dict (list item)))
            )
          )
          (if (not found) (setq new_dict (append new_dict (list (cons ml_type 1)))))
          (setq res_dict new_dict)
        )
      )
    )
  )

  ;;=========================================================
  ;; XUẤT KẾT QUẢ RA MÀN HÌNH
  ;;=========================================================
  (prompt "\n=== KẾT QUẢ BẢNG KÊ ===\n")
  (foreach item res_dict
    (if (= (substr (car item) 1 1) "P")
      (prompt (strcat "  " (car item) ": " (FormatNumber (cdr item)) " mm\n"))
    )
  )
  (prompt "\n--- FITTING ---\n")
  (foreach item res_dict
    (if (/= (substr (car item) 1 1) "P")
      (prompt (strcat "  " (car item) ": " (itoa (cdr item)) " cái\n"))
    )
  )

  ;;=========================================================
  ;; XUẤT FILE CSV
  ;;=========================================================
  (setq csv (getfiled "Lưu file CSV" "" "csv" 1))
  (if csv
    (progn
      (setq f (open csv "w") stt 0)
      (write-char 65279 f)  ; UTF-8 BOM để Excel đọc đúng tiếng Việt
      (write-line "STT,Ma vat tu,So luong / Chieu dai" f)
      
      (foreach item res_dict
        (if (= (substr (car item) 1 1) "P")
          (progn (setq stt (1+ stt))
                 (write-line (strcat (itoa stt) "," (car item) "," (FormatNumber (cdr item)) " mm") f))
        )
      )
      (foreach item res_dict
        (if (/= (substr (car item) 1 1) "P")
          (progn (setq stt (1+ stt))
                 (write-line (strcat (itoa stt) "," (car item) "," (itoa (cdr item)) " cai") f))
        )
      )
      (close f)
      (prompt (strcat "\n[OK] Đã xuất: " csv "\n"))
    )
  )

  ;; Khôi phục biến hệ thống
  (foreach v old_vars (setvar (car v) (cdr v)))
  (princ)
)

(princ "\nGõ BOM2D để chạy lệnh.")
(princ)
